#include <winver.h>
#include "resource.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
#define CREATEPROCESS_MANIFEST_RESOURCE_ID_ 1

CREATEPROCESS_MANIFEST_RESOURCE_ID_ RT_MANIFEST "capturefix.manifest"

/* The lower id is the one Explorer shows for the .exe, so the colour icon
   stays the application's face; the grey one is only used in the tray. */
IDI_APPICON      ICON "capturefix.ico"
IDI_APPICON_GRAY ICON "capturefix_gray.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,APP_VER_BUILD
PRODUCTVERSION  APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,APP_VER_BUILD
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rekow IT"
            VALUE "FileDescription",  "Fix Stuck Capture Border - detects and clears a stuck Windows Graphics Capture frame"
            VALUE "FileVersion",      APP_VER_STRING
            VALUE "InternalName",     "capturefix"
            VALUE "LegalCopyright",   "Copyright © 2026 Rekow IT"
            VALUE "OriginalFilename", "capturefix.exe"
            VALUE "ProductName",      "Fix Stuck Capture Border"
            VALUE "ProductVersion",   APP_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
